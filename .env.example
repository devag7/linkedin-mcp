# Active browser runtime configuration. Values are not loaded from this file automatically.
# Set them in your shell or MCP client's protected environment configuration.
LINKEDIN_PROVIDER=browser
TRANSPORT=stdio
PORT=3000
LOG_LEVEL=info
LINKEDIN_HEADLESS=true
LINKEDIN_IDLE_TIMEOUT_MS=300000
LINKEDIN_CONCURRENCY=1
# LINKEDIN_CHROME_PATH=/absolute/path/to/google-chrome
# LINKEDIN_PROFILE_DIR=/absolute/path/to/a-dedicated-profile
# Required only for loopback HTTP: generate a random 32-256 character secret.
# LINKEDIN_HTTP_TOKEN=
# Deliberate alpha opt-in. Confirmation and budgets still apply.
LINKEDIN_ENABLE_WRITES=false
# New message threads lack current successful integration evidence.
LINKEDIN_ENABLE_EXPERIMENTAL_MESSAGES=false
# No active tool accepts pasted OAuth/cookie credentials. No pacing bypass.
